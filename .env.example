# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только для Edge Functions (не для клиента!) — задаются через `supabase secrets set`,
# в .env.local НЕ нужны (Next.js их не должен видеть).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY Supabase прокидывает
# в Edge Functions автоматически, руками задавать нужно только эти два:
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# TELEGRAM_WEBHOOK_SECRET=любая-случайная-строка (для app/api/webhook-telegram)
